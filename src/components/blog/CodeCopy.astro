---
// src/components/blog/CodeCopy.astro
---

<script>
  function setupCodeBlocks() {
    // 본문(article) 안의 모든 pre 태그(코드 블록) 찾기
    const preElements = document.querySelectorAll('article pre');

    preElements.forEach((pre) => {
      // 이미 복사 버튼이 설치되어 있다면 중복 실행 방지
      if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

      // ⭐ Mermaid 다이어그램은 시각화 그래픽이므로 코드 복사 대상에서 제외
      if (
        pre.getAttribute('data-language') === 'mermaid' ||
        pre.classList.contains('language-mermaid') ||
        pre.querySelector('code')?.classList.contains('language-mermaid')
      ) {
        return;
      }

      // 1. 코드가 가로로 스크롤되어도 버튼이 고정될 수 있도록 래퍼 div 생성
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper relative group my-6';

      // 2. 언어 감지 (Astro/Shiki가 붙여둔 data-language 속성 또는 클래스에서 추출)
      const codeElement = pre.querySelector('code');
      const lang = 
        pre.getAttribute('data-language') || 
        codeElement?.className.match(/language-(\w+)/)?.[1] || 
        'code';

      // 3. 우측 상단 툴바 컨테이너 (언어 뱃지 + 복사 버튼)
      const toolbar = document.createElement('div');
      toolbar.className = 
        'absolute top-2 right-2 flex items-center gap-2 z-10 opacity-70 group-hover:opacity-100 transition-opacity duration-200';

      // 4. 언어 뱃지
      const langBadge = document.createElement('span');
      langBadge.className = 
        'text-[10px] font-mono uppercase font-semibold text-slate-400 bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700 select-none';
      langBadge.innerText = lang;

      // 5. 복사 버튼 생성 (Icon Swap + Success Check + Text Swap)
      const copyBtn = document.createElement('button');
      copyBtn.className = 
        'text-xs flex items-center gap-1.5 font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white px-2.5 py-1 rounded border border-slate-700 shadow-sm transition-colors';
      copyBtn.innerHTML = `
        <span class="m-icon-swap w-3.5 h-3.5" data-state="idle">
          <svg data-icon="primary" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg data-icon="secondary" class="w-3.5 h-3.5 text-emerald-400 m-success-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="m-text-swap" data-state="idle">
          <span>복사</span>
          <span class="text-emerald-400 font-semibold">복사됨!</span>
        </span>
      `;

      // 6. 클릭 이벤트: 클립보드 복사 실행
      copyBtn.addEventListener('click', async () => {
        const codeToCopy = codeElement ? codeElement.innerText : pre.innerText;

        try {
          await navigator.clipboard.writeText(codeToCopy);
          
          const iconSwap = copyBtn.querySelector('.m-icon-swap');
          const textSwap = copyBtn.querySelector('.m-text-swap');
          iconSwap?.setAttribute('data-state', 'active');
          textSwap?.setAttribute('data-state', 'active');
          copyBtn.classList.add('border-emerald-500/50');
          (window as any).showBlogToast?.('코드를 클립보드에 복사했습니다.');

          setTimeout(() => {
            iconSwap?.setAttribute('data-state', 'idle');
            textSwap?.setAttribute('data-state', 'idle');
            copyBtn.classList.remove('border-emerald-500/50');
          }, 2000);
        } catch (err) {
          console.error('클립보드 복사 실패:', err);
        }
      });

      // DOM에 조립하여 삽입
      toolbar.appendChild(langBadge);
      toolbar.appendChild(copyBtn);

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(toolbar);
      wrapper.appendChild(pre);
    });
  }

  // 페이지 로드 시 및 Astro 페이지 전환 시 실행
  setupCodeBlocks();
  document.addEventListener('astro:page-load', setupCodeBlocks);
</script>