---
// src/components/blog/Mermaid.astro
---

<!-- 1. 전체화면 라이트박스 모달 (안티그래비티 다크 스튜디오 디자인) -->
<div
  id="mermaid-modal"
  data-theme="dark"
  class="fixed inset-0 z-50 hidden bg-slate-950/85 backdrop-blur-md flex flex-col items-center justify-center p-3 sm:p-6 select-none"
>
  <div
    id="mermaid-modal-card"
    class="w-full max-w-7xl h-[92vh] rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-800 animate-in fade-in zoom-in-95 duration-150"
  >
    <div class="flex items-center justify-between px-6 py-3 border-b border-slate-800 bg-[#161b22] z-20 text-slate-200">
      <div class="flex items-center gap-2">
        <span class="text-base">📊</span>
        <span class="text-sm font-bold text-slate-100">아키텍처 다이어그램 스튜디오 뷰</span>
        <span class="text-[11px] text-slate-400 hidden md:inline ml-2">(드래그하여 이동 / 마우스 휠로 줌)</span>
      </div>

      <div class="flex items-center gap-2">
        <div class="flex items-center bg-[#21262d] rounded-lg border border-slate-700/60 p-0.5 shadow-xs">
          <button id="modal-zoom-out" type="button" class="px-2.5 py-1 text-xs font-bold text-slate-300 hover:bg-[#30363d] rounded transition-colors">－</button>
          <button id="modal-zoom-reset" type="button" class="px-2.5 py-1 text-xs font-semibold text-slate-300 hover:bg-[#30363d] rounded min-w-[50px] text-center transition-colors">100%</button>
          <button id="modal-zoom-in" type="button" class="px-2.5 py-1 text-xs font-bold text-slate-300 hover:bg-[#30363d] rounded transition-colors">＋</button>
        </div>
        <button
          id="mermaid-modal-close"
          type="button"
          class="flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-[#21262d] hover:bg-[#30363d] text-slate-200 border border-slate-700/60 transition-colors ml-2"
          title="닫기 (Esc)"
        >
          <span>✕</span>
          <span>닫기 (Esc)</span>
        </button>
      </div>
    </div>

    <div
      id="mermaid-modal-viewport"
      class="flex-1 overflow-hidden relative flex items-center justify-center cursor-grab active:cursor-grabbing"
    >
      <div id="mermaid-modal-content" class="transition-transform duration-75 ease-out flex items-center justify-center"></div>
    </div>
  </div>
</div>

<script>
  async function renderMermaidDiagrams() {
    const mermaidBlocks = document.querySelectorAll(
      'article pre[data-language="mermaid"], article pre.language-mermaid'
    );

    if (mermaidBlocks.length === 0) return;

    // Mermaid 공식 ESM 모듈 동적 로드
    const { default: mermaid } = await import(
      // @ts-ignore
      'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs'
    );

    // ⭐ 안티그래비티 다크 엔지니어링 스튜디오 테마 초기화
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      securityLevel: 'loose',
      fontFamily: 'ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif',
      themeVariables: {
        darkMode: true,
        background: '#0d1117',
        mainBkg: '#161b22',
        primaryColor: '#161b22',
        primaryTextColor: '#f0f6fc',
        primaryBorderColor: '#30363d',
        lineColor: '#8b949e',
        secondaryColor: '#161b22',
        tertiaryColor: '#21262d',
        clusterBkg: '#0d1117',
        clusterBorder: '#30363d',
        defaultLinkColor: '#8b949e',
        titleColor: '#c9d1d9',
        edgeLabelBackground: '#21262d',
        nodeTextColor: '#f0f6fc',
        nodeBorder: '#30363d',
        arrowheadColor: '#38bdf8',
        fontSize: '13px',
      },
      flowchart: {
        useMaxWidth: false,
        htmlLabels: true,
        padding: 18,
        nodeSpacing: 45,
        rankSpacing: 45,
      },
      themeCSS: `
        .node foreignObject { overflow: visible !important; }
        .node foreignObject div { line-height: 1.35 !important; font-size: 12.5px !important; color: #f0f6fc !important; }
      `,
    });

    // 모달 관련 요소 및 상태
    const modal = document.getElementById('mermaid-modal');
    const modalViewport = document.getElementById('mermaid-modal-viewport');
    const modalContent = document.getElementById('mermaid-modal-content');
    const modalClose = document.getElementById('mermaid-modal-close');
    const modalCard = document.getElementById('mermaid-modal-card');
    const modalZoomIn = document.getElementById('modal-zoom-in');
    const modalZoomOut = document.getElementById('modal-zoom-out');
    const modalZoomReset = document.getElementById('modal-zoom-reset');

    let modalScale = 1;
    let modalPointX = 0;
    let modalPointY = 0;
    let isModalPanning = false;
    let modalStartX = 0;
    let modalStartY = 0;

    function applyModalTransform() {
      if (modalContent) {
        modalContent.style.transform = `translate(${modalPointX}px, ${modalPointY}px) scale(${modalScale})`;
      }
      if (modalZoomReset) modalZoomReset.textContent = `${Math.round(modalScale * 100)}%`;
    }

    function resetModalTransform() {
      modalScale = 1;
      modalPointX = 0;
      modalPointY = 0;
      applyModalTransform();
    }

    modalZoomIn?.addEventListener('click', () => { modalScale = Math.min(4, modalScale + 0.2); applyModalTransform(); });
    modalZoomOut?.addEventListener('click', () => { modalScale = Math.max(0.3, modalScale - 0.2); applyModalTransform(); });
    modalZoomReset?.addEventListener('click', resetModalTransform);

    function closeModal() {
      if (modal) modal.classList.add('hidden');
      if (modalContent) modalContent.innerHTML = '';
      resetModalTransform();
    }
    modalClose?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
    });
    modal?.addEventListener('mousedown', (e) => {
      if (modalCard && !modalCard.contains(e.target as Node)) closeModal();
    });

    modalViewport?.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      isModalPanning = true;
      modalStartX = e.clientX - modalPointX;
      modalStartY = e.clientY - modalPointY;
    });
    window.addEventListener('mousemove', (e) => {
      if (!isModalPanning) return;
      modalPointX = e.clientX - modalStartX;
      modalPointY = e.clientY - modalStartY;
      applyModalTransform();
    });
    window.addEventListener('mouseup', () => { isModalPanning = false; });
    modalViewport?.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY < 0 ? 0.15 : -0.15;
      modalScale = Math.min(Math.max(0.3, modalScale + delta), 4.0);
      applyModalTransform();
    }, { passive: false });

    // 각 마크다운 다이어그램을 본문 인터랙티브 카드로 조립
    for (const [index, pre] of mermaidBlocks.entries()) {
      const code = pre.querySelector('code')?.innerText || (pre as HTMLElement).innerText;

      // 1. 전체 카드 래퍼 (안티그래비티 다크 스튜디오 스타일 기본 적용)
      const card = document.createElement('div');
      card.className = 'mermaid-card not-prose my-8 rounded-2xl border shadow-xl overflow-hidden select-none transition-colors';
      card.setAttribute('data-theme', 'dark');

      // 2. 카드 상단 툴바 (제목 + 테마 토글 + 줌 컨트롤러 + 소스 복사 + 전체화면)
      const toolbar = document.createElement('div');
      toolbar.className = 'mermaid-toolbar flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 border-b text-xs transition-colors';
      toolbar.innerHTML = `
        <div class="flex items-center gap-2 font-medium">
          <span class="text-sm">📊</span>
          <span class="toolbar-title font-semibold text-slate-100">아키텍처 다이어그램</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20">Studio View</span>
          <span class="toolbar-hint text-[11px] text-slate-400 font-normal hidden sm:inline">(드래그하여 이동 / 휠로 줌)</span>
        </div>
        <div class="flex items-center gap-2">
          <!-- ⭐ 다크/라이트 테마 전환 토글 버튼 -->
          <button
            type="button"
            class="card-theme-toggle flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-md transition-colors shadow-xs"
            title="다크 / 라이트 테마 전환"
          >
            <span class="theme-icon">🌙</span>
            <span class="theme-label hidden sm:inline">다크</span>
          </button>

          <!-- 인라인 줌 컨트롤러 -->
          <div class="flex items-center rounded-md border shadow-xs overflow-hidden toolbar-zoom-group">
            <button type="button" class="card-zoom-out px-2 py-1 text-xs font-bold transition-colors" title="축소">－</button>
            <button type="button" class="card-zoom-reset px-2.5 py-1 text-[11px] font-semibold min-w-[46px] text-center transition-colors" title="100% 리셋">100%</button>
            <button type="button" class="card-zoom-in px-2 py-1 text-xs font-bold transition-colors" title="확대">＋</button>
          </div>

          <!-- 소스 복사 버튼 -->
          <button 
            type="button" 
            class="card-copy-btn flex items-center gap-1 px-2.5 py-1 rounded-md font-medium transition-colors shadow-xs"
            title="Mermaid 소스 코드 클립보드 복사"
          >
            <span>📋</span>
            <span class="hidden sm:inline">코드 복사</span>
          </button>

          <!-- 전체화면 버튼 -->
          <button 
            type="button" 
            class="card-fullscreen-btn flex items-center gap-1 px-2.5 py-1 rounded-md font-medium transition-colors shadow-xs"
            title="전체화면 모달로 보기"
          >
            <span>⛶</span>
            <span class="hidden sm:inline">전체화면</span>
          </button>
        </div>
      `;

      // 3. 본문 캔버스 뷰포트 (높이 480px, 드래그 및 줌 가능)
      const viewport = document.createElement('div');
      viewport.className = 'mermaid-viewport h-[480px] w-full overflow-hidden relative flex items-center justify-center cursor-grab active:cursor-grabbing';

      const content = document.createElement('div');
      content.className = 'mermaid-content transition-transform duration-75 ease-out flex items-center justify-center';

      try {
        const { svg } = await mermaid.render(`mermaid-svg-${index}`, code);
        content.innerHTML = svg;

        const svgElement = content.querySelector('svg');
        if (svgElement) {
          svgElement.style.maxWidth = 'none';
          svgElement.style.height = 'auto';

          const viewBox = svgElement.getAttribute('viewBox');
          if (viewBox) {
            const parts = viewBox.split(/\s+/).map(Number);
            const naturalWidth = parts[2];
            if (naturalWidth && naturalWidth > 700) {
              svgElement.style.minWidth = `${naturalWidth}px`;
            }
          }
        }

        viewport.appendChild(content);
        card.appendChild(toolbar);
        card.appendChild(viewport);

        // ⭐ 다크 / 라이트 테마 토글 핸들러
        const themeBtn = toolbar.querySelector('.card-theme-toggle') as HTMLButtonElement | null;
        const themeIcon = themeBtn?.querySelector('.theme-icon');
        const themeLabel = themeBtn?.querySelector('.theme-label');

        themeBtn?.addEventListener('click', () => {
          const currentTheme = card.getAttribute('data-theme') || 'dark';
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          card.setAttribute('data-theme', newTheme);
          if (themeIcon) themeIcon.textContent = newTheme === 'dark' ? '🌙' : '☀️';
          if (themeLabel) themeLabel.textContent = newTheme === 'dark' ? '다크' : '라이트';
        });

        // ⭐ 본문 카드 내 인라인 줌 & 팬 상태 관리
        let cardScale = 1;
        let cardPointX = 0;
        let cardPointY = 0;
        let isCardPanning = false;
        let cardStartX = 0;
        let cardStartY = 0;

        const cardZoomIn = toolbar.querySelector('.card-zoom-in');
        const cardZoomOut = toolbar.querySelector('.card-zoom-out');
        const cardZoomReset = toolbar.querySelector('.card-zoom-reset');
        const cardCopyBtn = toolbar.querySelector('.card-copy-btn');
        const cardFullscreenBtn = toolbar.querySelector('.card-fullscreen-btn');

        function applyCardTransform() {
          content.style.transform = `translate(${cardPointX}px, ${cardPointY}px) scale(${cardScale})`;
          if (cardZoomReset) cardZoomReset.textContent = `${Math.round(cardScale * 100)}%`;
        }

        function setCardScale(newScale: number) {
          cardScale = Math.min(Math.max(0.3, newScale), 3.5);
          applyCardTransform();
        }

        cardZoomIn?.addEventListener('click', () => setCardScale(cardScale + 0.2));
        cardZoomOut?.addEventListener('click', () => setCardScale(cardScale - 0.2));
        cardZoomReset?.addEventListener('click', () => {
          cardScale = 1;
          cardPointX = 0;
          cardPointY = 0;
          applyCardTransform();
        });

        // 본문 캔버스 마우스 드래그 (Pan)
        viewport.addEventListener('mousedown', (e) => {
          if (e.button !== 0) return;
          isCardPanning = true;
          cardStartX = e.clientX - cardPointX;
          cardStartY = e.clientY - cardPointY;
        });

        window.addEventListener('mousemove', (e) => {
          if (!isCardPanning) return;
          cardPointX = e.clientX - cardStartX;
          cardPointY = e.clientY - cardStartY;
          applyCardTransform();
        });

        window.addEventListener('mouseup', () => {
          isCardPanning = false;
        });

        // 본문 캔버스 휠 줌 (Wheel Zoom)
        viewport.addEventListener('wheel', (e) => {
          e.preventDefault();
          const delta = e.deltaY < 0 ? 0.12 : -0.12;
          setCardScale(cardScale + delta);
        }, { passive: false });

        // ⭐ 다이어그램 소스 코드 복사 기능
        cardCopyBtn?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code);
            cardCopyBtn.innerHTML = `<span>✓</span><span class="text-emerald-400 font-semibold">복사됨!</span>`;
            setTimeout(() => {
              cardCopyBtn.innerHTML = `<span>📋</span><span class="hidden sm:inline">코드 복사</span>`;
            }, 2000);
          } catch (err) {
            console.error('클립보드 복사 실패:', err);
          }
        });

        // 전체화면 모달 열기 (카드의 현재 테마 동기화)
        cardFullscreenBtn?.addEventListener('click', () => {
          if (modal && modalContent) {
            const activeTheme = card.getAttribute('data-theme') || 'dark';
            modal.setAttribute('data-theme', activeTheme);
            modalContent.innerHTML = svg;
            const modalSvg = modalContent.querySelector('svg');
            if (modalSvg) {
              modalSvg.style.maxWidth = 'none';
              modalSvg.style.height = 'auto';
              modalSvg.style.minWidth = '900px';
            }
            resetModalTransform();
            modal.classList.remove('hidden');
          }
        });

        // 돔 교체
        const targetToReplace = pre.parentElement?.classList.contains('code-block-wrapper')
          ? pre.parentElement
          : pre;
        targetToReplace.parentElement?.replaceChild(card, targetToReplace);
      } catch (err) {
        console.error('Mermaid render error:', err);
      }
    }
  }

  renderMermaidDiagrams();
  document.addEventListener('astro:page-load', renderMermaidDiagrams);
</script>

<style is:global>
  /* ==========================================================================
     안티그래비티 스타일 Mermaid 하이테크 스튜디오 테마 (다크 & 라이트 지원)
     ========================================================================== */

  /* 🌙 다크 테마 변수 (안티그래비티 다크 스튜디오 - 기본값) */
  .mermaid-card[data-theme="dark"],
  #mermaid-modal[data-theme="dark"] {
    --mm-card-border: #30363d;
    --mm-toolbar-bg: #161b22;
    --mm-toolbar-border: #30363d;
    --mm-toolbar-title: #f0f6fc;
    --mm-toolbar-hint: #8b949e;
    --mm-canvas-bg: #0d1117;
    --mm-dot-color: rgba(255, 255, 255, 0.08);

    --mm-btn-bg: #21262d;
    --mm-btn-border: #30363d;
    --mm-btn-hover: #30363d;
    --mm-btn-text: #e6edf3;

    --mm-node-bg: #161b22;
    --mm-node-border: #484f58;
    --mm-node-text: #f0f6fc;

    --mm-cluster-bg: #0d1117;
    --mm-cluster-border: #30363d;
    --mm-cluster-text: #c9d1d9;

    --mm-line: #8b949e;
    --mm-arrow: #38bdf8; /* 일렉트릭 블루 화살표 */

    --mm-pill-bg: #21262d;
    --mm-pill-border: #444c56;
    --mm-pill-text: #e6edf3;
  }

  /* ☀️ 라이트 테마 변수 (모던 인디고 스튜디오) */
  .mermaid-card[data-theme="light"],
  #mermaid-modal[data-theme="light"] {
    --mm-card-border: #e2e8f0;
    --mm-toolbar-bg: #f8fafc;
    --mm-toolbar-border: #e2e8f0;
    --mm-toolbar-title: #0f172a;
    --mm-toolbar-hint: #64748b;
    --mm-canvas-bg: #ffffff;
    --mm-dot-color: rgba(0, 0, 0, 0.05);

    --mm-btn-bg: #ffffff;
    --mm-btn-border: #cbd5e1;
    --mm-btn-hover: #f1f5f9;
    --mm-btn-text: #334155;

    --mm-node-bg: #ffffff;
    --mm-node-border: #cbd5e1;
    --mm-node-text: #0f172a;

    --mm-cluster-bg: #f8fafc;
    --mm-cluster-border: #e2e8f0;
    --mm-cluster-text: #334155;

    --mm-line: #64748b;
    --mm-arrow: #4f46e5; /* 인디고 화살표 */

    --mm-pill-bg: #ffffff;
    --mm-pill-border: #cbd5e1;
    --mm-pill-text: #334155;
  }

  /* 카드 컨테이너 및 툴바 스타일 */
  .mermaid-card {
    border-color: var(--mm-card-border) !important;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
  }
  .mermaid-toolbar {
    background-color: var(--mm-toolbar-bg) !important;
    border-color: var(--mm-toolbar-border) !important;
  }
  .mermaid-toolbar .toolbar-title {
    color: var(--mm-toolbar-title) !important;
  }
  .mermaid-toolbar .toolbar-hint {
    color: var(--mm-toolbar-hint) !important;
  }
  .mermaid-toolbar button,
  .mermaid-toolbar .toolbar-zoom-group {
    background-color: var(--mm-btn-bg) !important;
    border-color: var(--mm-btn-border) !important;
    color: var(--mm-btn-text) !important;
  }
  .mermaid-toolbar button:hover {
    background-color: var(--mm-btn-hover) !important;
  }

  /* 모달 카드 스타일 */
  #mermaid-modal-card {
    border-color: var(--mm-card-border) !important;
  }

  /* 엔지니어링 캔버스 그리드 */
  .mermaid-card .mermaid-viewport,
  #mermaid-modal #mermaid-modal-viewport {
    background-color: var(--mm-canvas-bg) !important;
    background-image: radial-gradient(var(--mm-dot-color) 1.2px, transparent 1.2px) !important;
    background-size: 24px 24px !important;
  }

  /* 1. 노드(Node) 사각형/원형/다각형 스타일 */
  .mermaid-card svg .node rect,
  .mermaid-card svg .node circle,
  .mermaid-card svg .node polygon,
  #mermaid-modal svg .node rect,
  #mermaid-modal svg .node circle,
  #mermaid-modal svg .node polygon {
    fill: var(--mm-node-bg) !important;
    stroke: var(--mm-node-border) !important;
    stroke-width: 1.5px !important;
    rx: 8px !important;
  }

  /* 2. 노드 내부 텍스트 타이포그래피 */
  .mermaid-card svg .node foreignObject div,
  .mermaid-card svg .node text,
  .mermaid-card svg .node .label,
  #mermaid-modal svg .node foreignObject div,
  #mermaid-modal svg .node text,
  #mermaid-modal svg .node .label {
    color: var(--mm-node-text) !important;
    fill: var(--mm-node-text) !important;
    font-size: 12.5px !important;
    line-height: 1.4 !important;
    font-weight: 500 !important;
    word-break: keep-all;
    text-align: center;
  }

  /* 3. 서브그래프(Cluster) 박스 */
  .mermaid-card svg .cluster rect,
  #mermaid-modal svg .cluster rect {
    fill: var(--mm-cluster-bg) !important;
    stroke: var(--mm-cluster-border) !important;
    stroke-width: 1.5px !important;
    rx: 8px !important;
  }
  .mermaid-card svg .cluster .nodeLabel,
  #mermaid-modal svg .cluster .nodeLabel {
    color: var(--mm-cluster-text) !important;
    fill: var(--mm-cluster-text) !important;
    font-weight: 600 !important;
    font-size: 13px !important;
  }

  /* 4. 연결선(Edges) */
  .mermaid-card svg .edgePath .path,
  #mermaid-modal svg .edgePath .path {
    stroke: var(--mm-line) !important;
    stroke-width: 1.5px !important;
  }

  /* 5. ⭐ 화살표 머리 (Arrowheads - 일렉트릭 블루/인디고 포인트 컬러) */
  .mermaid-card svg marker path,
  #mermaid-modal svg marker path {
    fill: var(--mm-arrow) !important;
