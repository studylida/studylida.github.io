---
// src/components/blog/PostCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<article class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 hover:shadow-md hover:border-indigo-200 transition-all group">
  <div class="flex items-center gap-3 text-xs text-slate-500 mb-2">
    <a 
      href={`/category/${post.data.category}/`}
      class="font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full hover:bg-indigo-100 transition-colors"
    >
      {post.data.category}
    </a>
    <time datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
  </div>

  <h3 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors mb-2">
    <a href={`/posts/${post.slug}/`}>
      {post.data.title}
    </a>
  </h3>

  <p class="text-slate-600 text-sm mb-4 line-clamp-2">
    {post.data.description}
  </p>

  <div class="flex flex-wrap gap-1.5">
    {post.data.tags.map((tag) => (
      <a
        href={`/tags/${tag}/`}
        class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
      >
        #{tag}
      </a>
    ))}
  </div>
</article>