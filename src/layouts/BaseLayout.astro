---
// src/layouts/BaseLayout.astro 상단
import '../styles/global.css';
import '../styles/motion.css';
import KnowledgePopover from '../components/interactive/KnowledgePopover.astro';
import SearchModal from '../components/interactive/SearchModal.astro'; // ⭐ 1. 임포트

interface Props {
  title: string;
  description?: string;
}

const { title, description = "blog where I record my study notes" } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
    <script is:inline>
      if (localStorage.getItem('blog-focus-mode') === 'true') {
        document.documentElement.classList.add('focus-mode');
      }
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen">
    <header class="border-b border-slate-200 bg-white/80 backdrop-blur sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-extrabold text-lg text-slate-900 hover:text-indigo-600 transition-colors flex items-center gap-2">
          <span>📚</span>
          <span>studylida</span>
        </a>

        <div class="flex items-center gap-4">
          <!-- ⭐ 2. 빠른 검색 열기 버튼 -->
          <button
            type="button"
            class="open-search-trigger flex items-center gap-2 px-3 py-1.5 text-xs text-slate-500 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200/80 transition-colors"
            title="검색 (Ctrl + K)"
          >
            <span>🔍</span>
            <span class="hidden sm:inline">빠른 검색</span>
            <kbd class="hidden sm:inline font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 text-[10px] text-slate-400">
              Ctrl K
            </kbd>
          </button>

          <nav class="flex items-center gap-4 text-sm font-medium text-slate-600">
            <a href="/" class="hover:text-indigo-600 transition-colors">홈</a>
            <a 
              href="https://github.com/studylida" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-indigo-600 transition-colors flex items-center gap-1"
            >
              <span>GitHub</span>
              <span class="text-xs">↗</span>
            </a>
            <a href="/rss.xml" class="hover:text-indigo-600 transition-colors" title="RSS 피드">
              <span>RSS</span>
            </a>
          </nav>

          <!-- 헤더 다크(집중 읽기) 모드 토글 -->
          <button
            type="button"
            role="switch"
            aria-checked="false"
            id="header-focus-toggle"
            class="m-toggle relative inline-flex h-6 w-11 items-center rounded-full bg-slate-200 p-0.5 transition-colors shrink-0 border border-slate-300/70"
            title="다크 / 라이트 모드 전환"
            aria-label="다크 모드 전환"
          >
            <span class="m-toggle-thumb inline-flex h-5 w-5 items-center justify-center rounded-full bg-white shadow-sm text-slate-700">
              <svg id="header-sun-icon" class="w-3 h-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
              <svg id="header-moon-icon" class="hidden w-3 h-3 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-slate-200 py-8 text-center text-sm text-slate-500">
      <p>
        © 2026 studylida. Built with Astro & Tailwind CSS.
        <span class="mx-2 text-slate-300">·</span>
        <a href="/ui" class="hover:text-indigo-600 transition-colors">UI & Motion Lab</a>
      </p>
    </footer>

    <!-- 전역 인터랙션 컴포넌트들 -->
    <KnowledgePopover />
    <SearchModal /> <!-- ⭐ 3. 모달 장착 -->

    <!-- 전역 Toast 알림 -->
    <div
      id="blog-toast"
      data-open="false"
      role="status"
      aria-live="polite"
      class="m-toast fixed bottom-6 left-6 z-50 flex items-center gap-2.5 bg-slate-900 text-white text-xs font-medium px-4 py-3 rounded-xl shadow-lg border border-slate-700"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
      <span id="blog-toast-msg">알림</span>
    </div>

    <!-- 위로 스크롤 시 상단 정중앙에 나타나는 '맨 위로 이동' 버튼 -->
    <div class="fixed top-20 left-0 right-0 z-40 flex justify-center pointer-events-none">
      <button
        type="button"
        id="scroll-top-pill"
        data-open="false"
        aria-label="맨 위로 이동"
        class="m-popover inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-slate-900/90 backdrop-blur-md text-white text-xs font-semibold shadow-lg border border-slate-700/70 hover:bg-indigo-600 transition-colors"
      >
        <span>↑</span>
        <span>맨 위로</span>
      </button>
    </div>

    <script>
      // 전역 Toast 유틸리티
      let blogToastTimer: number | undefined;
      (window as any).showBlogToast = (msg: string) => {
        const toast = document.getElementById('blog-toast');
        const msgEl = document.getElementById('blog-toast-msg');
        if (!toast || !msgEl) return;
        msgEl.textContent = msg;
        toast.setAttribute('data-open', 'true');
        window.clearTimeout(blogToastTimer);
        blogToastTimer = window.setTimeout(() => {
          toast.setAttribute('data-open', 'false');
        }, 2200);
      };

      // 헤더 다크(집중 읽기) 모드 토글
      const focusToggle = document.getElementById('header-focus-toggle');
      const sunIcon = document.getElementById('header-sun-icon');
      const moonIcon = document.getElementById('header-moon-icon');
      function syncFocusToggle() {
        const active = document.documentElement.classList.contains('focus-mode');
        focusToggle?.setAttribute('aria-checked', String(active));
        focusToggle?.classList.toggle('bg-indigo-600', active);
        focusToggle?.classList.toggle('border-indigo-500', active);
        focusToggle?.classList.toggle('bg-slate-200', !active);
        sunIcon?.classList.toggle('hidden', active);
        moonIcon?.classList.toggle('hidden', !active);
      }
      syncFocusToggle();

      focusToggle?.addEventListener('click', () => {
        const next = !document.documentElement.classList.contains('focus-mode');
        document.documentElement.classList.toggle('focus-mode', next);
        localStorage.setItem('blog-focus-mode', String(next));
        syncFocusToggle();
        (window as any).showBlogToast?.(next ? '다크 모드를 켰습니다.' : '라이트 모드로 전환했습니다.');
      });

      // 위로 스크롤 시 상단에 '맨 위로' 버튼 표시
      const scrollTopPill = document.getElementById('scroll-top-pill');
      let lastScrollY = window.scrollY;
      window.addEventListener(
        'scroll',
        () => {
          const currentY = window.scrollY;
          const isScrollingUp = currentY < lastScrollY;
          const shouldShow = currentY > 280 && isScrollingUp;
          scrollTopPill?.setAttribute('data-open', shouldShow ? 'true' : 'false');
          lastScrollY = currentY;
        },
        { passive: true }
      );

      scrollTopPill?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        scrollTopPill.setAttribute('data-open', 'false');
      });
    </script>
  </body>
</html>