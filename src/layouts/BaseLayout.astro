---
// src/layouts/BaseLayout.astro 상단
import '../styles/global.css';
import KnowledgePopover from '../components/interactive/KnowledgePopover.astro';
import SearchModal from '../components/interactive/SearchModal.astro'; // ⭐ 1. 임포트

interface Props {
  title: string;
  description?: string;
}

const { title, description = "blog where I record my study notes" } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen">
    <header class="border-b border-slate-200 bg-white/80 backdrop-blur sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-extrabold text-lg text-slate-900 hover:text-indigo-600 transition-colors flex items-center gap-2">
          <span>📚</span>
          <span>studylida</span>
        </a>

        <div class="flex items-center gap-4">
          <!-- ⭐ 2. 빠른 검색 열기 버튼 -->
          <button
            type="button"
            class="open-search-trigger flex items-center gap-2 px-3 py-1.5 text-xs text-slate-500 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200/80 transition-colors"
            title="검색 (Ctrl + K)"
          >
            <span>🔍</span>
            <span class="hidden sm:inline">빠른 검색</span>
            <kbd class="hidden sm:inline font-mono bg-white px-1.5 py-0.5 rounded border border-slate-200 text-[10px] text-slate-400">
              Ctrl K
            </kbd>
          </button>

          <nav class="flex items-center gap-4 text-sm font-medium text-slate-600">
            <a href="/" class="hover:text-indigo-600 transition-colors">홈</a>
            <a 
              href="https://github.com/studylida" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hover:text-indigo-600 transition-colors flex items-center gap-1"
            >
              <span>GitHub</span>
              <span class="text-xs">↗</span>
            </a>
            <a href="/rss.xml" class="hover:text-indigo-600 transition-colors" title="RSS 피드">
              <span>RSS</span>
            </a>
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-slate-200 py-8 text-center text-sm text-slate-500">
      <p>© 2026 studylida. Built with Astro & Tailwind CSS.</p>
    </footer>

    <!-- 전역 인터랙션 컴포넌트들 -->
    <KnowledgePopover />
    <SearchModal /> <!-- ⭐ 3. 모달 장착 -->
  </body>
</html>