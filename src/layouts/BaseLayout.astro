---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import KnowledgePopover from '../components/interactive/KnowledgePopover.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "공부한 지식을 기록하고 연결하는 블로그" } = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen">
    <!-- 상단 글로벌 네비게이션 헤더 -->
    <header class="border-b border-slate-200 bg-white/80 backdrop-blur sticky top-0 z-10">
      <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-extrabold text-lg text-slate-900 hover:text-indigo-600 transition-colors flex items-center gap-2">
          <span>📚</span>
          <span>지식 서재</span>
        </a>
        <nav class="flex items-center gap-4 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-indigo-600 transition-colors">홈</a>
        </nav>
      </div>
    </header>

    <!-- ⭐ <slot />: 각 페이지(index, 상세 글 등)의 고유한 내용이 쏙 들어가는 자리입니다. -->
    <slot />

    <!-- 푸터 -->
    <footer class="mt-20 border-t border-slate-200 py-8 text-center text-sm text-slate-500">
      <p>© 2026 지식 서재. Built with Astro & Tailwind CSS.</p>
    </footer>

    <!-- ⭐ 전역 팝오버 마운트 -->
    <KnowledgePopover />
  </body>
</html>