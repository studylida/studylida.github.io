---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategorySidebar from '../components/blog/CategorySidebar.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title="studylida 📚 - 기술 블로그">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <!-- 헤더 -->
    <header class="mb-10 border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 mb-2">
        studylida 📚
      </h1>
      <p class="text-slate-600">
        공부한 기술 개념들을 기록하고 연결하는 공간입니다.
      </p>
    </header>

    <!-- 2단 레이아웃 (좌: 사이드바 / 우: 글 목록) -->
    <div class="flex flex-col md:flex-row gap-10">
      <!-- 1. 좌측 사이드바 -->
      <CategorySidebar />

      <!-- 2. 우측 글 목록 메인 영역 -->
      <main class="flex-1">
        <div class="mb-6">
          <h2 class="text-lg font-bold text-slate-800">
            전체 글 ({sortedPosts.length})
          </h2>
        </div>

        <div class="grid gap-6">
          {sortedPosts.map((post) => (
            <article class="bg-white rounded-xl p-6 shadow-sm border border-slate-200 hover:shadow-md hover:border-indigo-200 transition-all group">
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-2">
                <a 
                  href={`/category/${post.data.category}/`}
                  class="font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full hover:bg-indigo-100 transition-colors"
                >
                  {post.data.category}
                </a>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>

              <h3 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors mb-2">
                <a href={`/posts/${post.slug}/`}>
                  {post.data.title}
                </a>
              </h3>

              <p class="text-slate-600 text-sm mb-4 line-clamp-2">
                {post.data.description}
              </p>

              <div class="flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}/`}
                    class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </main>
    </div>
  </div>
</BaseLayout>