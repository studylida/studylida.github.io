---
// src/pages/posts/[...slug].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/blog/TOC.astro';
import CodeCopy from '../../components/blog/CodeCopy.astro'; 
import Mermaid from '../../components/blog/Mermaid.astro';
import { sortPosts, formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  // 1. 임시저장이 아닌 글들을 최신순(시간 포함 내림차순)으로 안전하게 정렬
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);
  const sortedPosts = sortPosts(allPosts);

  // 2. 각 글마다 이전 글(과거 글)과 다음 글(최신 글)을 계산하여 props로 전달
  return sortedPosts.map((post, index) => {
    // index가 0이면 가장 최신 글이므로 다음 글이 없음
    const nextPost = index > 0 ? sortedPosts[index - 1] : null;
    // index가 마지막이면 가장 오래된 글이므로 이전 글이 없음
    const prevPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;

    return {
      params: { slug: post.slug },
      props: { post, prevPost, nextPost },
    };
  });
}

// props에서 post와 함께 prevPost, nextPost를 꺼냅니다!
const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="max-w-6xl mx-auto py-12 px-6">
    <nav class="mb-8">
      <a 
        href="/" 
        class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors"
      >
        ← 목록으로 돌아가기
      </a>
    </nav>

    <div class="flex flex-col xl:flex-row gap-12 items-start">
      <!-- 메인 아티클 영역 -->
      <article class="flex-1 min-w-0 max-w-3xl">
        <header class="mb-10 pb-8 border-b border-slate-200">
          <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
            <a 
              href={`/category/${post.data.category}/`}
              class="font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full hover:bg-indigo-100 transition-colors"
            >
              {post.data.category}
            </a>
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
            {post.data.title}
          </h1>

          <p class="text-lg text-slate-600 mb-6">
            {post.data.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${tag}/`}
                class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md font-medium hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        </header>

        <!-- 본문 렌더링 -->
        <main class="prose prose-slate lg:prose-lg max-w-none">
          <Content />
        </main>

        <!-- ⭐ 본문 하단: 이전 글 / 다음 글 내비게이션 카드 -->
        <nav class="mt-16 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={`/posts/${prevPost.slug}/`}
              class="group p-4 rounded-xl border border-slate-200 hover:border-indigo-300 hover:shadow-sm transition-all bg-white flex flex-col justify-between"
            >
              <span class="text-xs text-slate-400 font-semibold mb-1 flex items-center gap-1">
                ← 이전 글
              </span>
              <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div /> <!-- 왼쪽 빈 자리 유지용 -->
          )}

          {nextPost && (
            <a
              href={`/posts/${nextPost.slug}/`}
              class="group p-4 rounded-xl border border-slate-200 hover:border-indigo-300 hover:shadow-sm transition-all bg-white flex flex-col justify-between text-right sm:col-start-2"
            >
              <span class="text-xs text-slate-400 font-semibold mb-1 flex items-center justify-end gap-1">
                다음 글 →
              </span>
              <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>
      </article>

      <!-- 우측 목차 -->
      <TOC headings={headings} />
    </div>
  </div>
  <CodeCopy />
  <Mermaid />
</BaseLayout>