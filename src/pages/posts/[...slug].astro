---
// src/pages/posts/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/blog/TOC.astro';
import CodeCopy from '../../components/blog/CodeCopy.astro'; 
import Mermaid from '../../components/blog/Mermaid.astro';
import Comments from '../../components/blog/Comments.astro';
import { sortPosts, formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  // 1. 임시저장이 아닌 글들을 최신순(시간 포함 내림차순)으로 안전하게 정렬
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);
  const sortedPosts = sortPosts(allPosts);

  // 2. 각 글마다 이전 글(과거 글)과 다음 글(최신 글)을 계산하여 props로 전달
  return sortedPosts.map((post, index) => {
    // index가 0이면 가장 최신 글이므로 다음 글이 없음
    const nextPost = index > 0 ? sortedPosts[index - 1] : null;
    // index가 마지막이면 가장 오래된 글이므로 이전 글이 없음
    const prevPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

// props에서 post와 함께 prevPost, nextPost를 꺼냅니다!
const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="max-w-7xl mx-auto py-12 px-6">
    <nav class="mb-8">
      <a 
        href="/" 
        class="m-learn-more inline-flex items-center gap-1 text-sm font-medium text-slate-500 hover:text-indigo-600 transition-colors"
      >
        <span>← 목록으로 돌아가기</span>
      </a>
    </nav>

    <div class="flex flex-col xl:flex-row gap-10 items-start">
      <!-- 메인 아티클 영역 -->
      <article class="flex-1 min-w-0 w-full">
        <header class="mb-10 pb-8 border-b border-slate-200">
          <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 mb-3">
            <div class="flex flex-wrap items-center gap-1.5">
              {post.data.categories.map((cat) => (
                <a 
                  href={`/category/${cat}/`}
                  class="font-semibold text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full hover:bg-indigo-100 transition-colors"
                >
                  {cat}
                </a>
              ))}
            </div>
            <span class="text-slate-300">·</span>
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4 m-texts-reveal">
            {post.data.title}
          </h1>

          <p class="text-lg text-slate-600 mb-6 m-texts-reveal m-texts-reveal-delay-1">
            {post.data.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${tag}/`}
                class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-md font-medium hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        </header>

        <!-- 본문 렌더링 -->
        <main class="prose prose-slate lg:prose-lg max-w-none">
          <Content />
        </main>

        <!-- 본문 하단 리액션 & 공유 블록 (Like + Confetti + Share) -->
        <div class="mt-12 pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="post-like-btn"
              data-slug={post.id}
              data-liked="false"
              class="m-like-btn relative inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:border-rose-300 transition-colors shadow-sm"
            >
              <svg class="w-4 h-4 text-slate-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
              <span class="m-text-swap" data-state="idle">
                <span>글이 도움됐어요</span>
                <span class="text-rose-600">좋아요 완료!</span>
              </span>
            </button>
          </div>

          <button
            type="button"
            id="post-share-btn"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700 transition-colors"
          >
            <span class="m-icon-swap w-3.5 h-3.5" data-state="idle">
              <svg data-icon="primary" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <svg data-icon="secondary" class="w-3.5 h-3.5 text-emerald-600 m-success-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="m-text-swap" data-state="idle">
              <span>글 링크 복사</span>
              <span class="text-emerald-600">복사됨!</span>
            </span>
          </button>
        </div>

        <!-- ⭐ 본문 하단: 이전 글 / 다음 글 내비게이션 카드 -->
        <nav class="mt-8 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={`/posts/${prevPost.id}/`}
              class="group p-4 rounded-xl border border-slate-200 hover:border-indigo-300 hover:shadow-sm transition-all bg-white flex flex-col justify-between"
            >
              <span class="text-xs text-slate-400 font-semibold mb-1 flex items-center gap-1">
                ← 이전 글
              </span>
              <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div /> <!-- 왼쪽 빈 자리 유지용 -->
          )}

          {nextPost && (
            <a
              href={`/posts/${nextPost.id}/`}
              class="m-learn-more group p-4 rounded-xl border border-slate-200 hover:border-indigo-300 hover:shadow-sm transition-all bg-white flex flex-col justify-between text-right sm:col-start-2"
            >
              <span class="text-xs text-slate-400 font-semibold mb-1 flex items-center justify-end gap-1">
                <span>다음 글</span>
                <span class="m-learn-more-arrow">→</span>
              </span>
              <span class="text-sm font-bold text-slate-800 group-hover:text-indigo-600 transition-colors line-clamp-1">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>

        <!-- 댓글 영역 (Giscus) -->
        <Comments />
      </article>

      <!-- 우측 목차 -->
      <TOC headings={headings} />
    </div>
  </div>
  <CodeCopy />
  <Mermaid />

  <script>
    const likeBtn = document.getElementById('post-like-btn');
    const slug = likeBtn?.getAttribute('data-slug') || '';
    const storageKey = `blog-liked-${slug}`;

    function spawnConfetti(anchor: HTMLElement) {
      const colors = ['#6366f1', '#ec4899', '#10b981', '#f59e0b', '#38bdf8'];
      for (let i = 0; i < 12; i++) {
        const dot = document.createElement('span');
        dot.className = 'm-confetti-dot';
        dot.style.backgroundColor = colors[i % colors.length];
        dot.style.left = '50%';
        dot.style.top = '50%';
        const angle = (Math.PI * 2 * i) / 12 + (Math.random() - 0.5) * 0.4;
        const dist = 28 + Math.random() * 26;
        dot.style.setProperty('--tx', `${Math.cos(angle) * dist}px`);
        dot.style.setProperty('--ty', `${Math.sin(angle) * dist - 12}px`);
        dot.style.setProperty('--rot', `${Math.round(Math.random() * 360)}deg`);
        anchor.appendChild(dot);
        setTimeout(() => dot.remove(), 700);
      }
    }

    function applyLikeState(liked: boolean) {
      if (!likeBtn) return;
      likeBtn.setAttribute('data-liked', String(liked));
      likeBtn.querySelector('.m-text-swap')?.setAttribute('data-state', liked ? 'active' : 'idle');
      const svg = likeBtn.querySelector('svg');
      if (svg) {
        svg.setAttribute('fill', liked ? 'currentColor' : 'none');
        svg.classList.toggle('text-rose-500', liked);
        svg.classList.toggle('text-slate-400', !liked);
      }
      likeBtn.classList.toggle('border-rose-300', liked);
    }

    if (slug && localStorage.getItem(storageKey) === 'true') {
      applyLikeState(true);
    }

    likeBtn?.addEventListener('click', () => {
      const next = likeBtn.getAttribute('data-liked') !== 'true';
      applyLikeState(next);
      if (slug) localStorage.setItem(storageKey, String(next));
      if (next) {
        spawnConfetti(likeBtn);
        (window as any).showBlogToast?.('응원 감사합니다!');
      }
    });

    const shareBtn = document.getElementById('post-share-btn');
    shareBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const iconSwap = shareBtn.querySelector('.m-icon-swap');
        const textSwap = shareBtn.querySelector('.m-text-swap');
        iconSwap?.setAttribute('data-state', 'active');
        textSwap?.setAttribute('data-state', 'active');
        (window as any).showBlogToast?.('글 링크를 클립보드에 복사했습니다.');
        setTimeout(() => {
          iconSwap?.setAttribute('data-state', 'idle');
          textSwap?.setAttribute('data-state', 'idle');
        }, 1800);
      } catch {}
    });
  </script>
</BaseLayout>